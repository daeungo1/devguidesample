{
  "name": "contoso-energy-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Contoso Energy MCP Apps server: appliance energy dashboard rendered inside the agent host.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:app": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:app && npm run build:server",
    "dev": "npm run build:app && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^5.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}
